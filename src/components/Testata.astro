---
import Marca from './Marca.astro';
import InterruttoreTema from './InterruttoreTema.astro';
import { u } from '../lib/percorsi';
import sito from '../data/sito.json';

// Il menu resta di tre voci qualunque sia il numero di libri: i titoli
// vivono nel catalogo, mai nella barra di navigazione.
const voci = [
  { testo: 'Manifesto', href: u('/manifesto/') },
  { testo: 'Catalogo', href: u('/catalogo/') },
  { testo: 'Contatti', href: u('/contatti/') },
];

const percorso = Astro.url.pathname.replace(/\/+$/, '') + '/';
const attiva = (href: string) => percorso.startsWith(href);
---

<header class="testata">
  <div class="contenitore testata__interno">
    <a class="insegna" href={u('/')} aria-label={`${sito.nome} — pagina iniziale`}>
      <Marca dimensione={34} titolo={sito.nome} />
      <span class="insegna__testo">
        <span class="insegna__nome">Pico Edizioni</span>
        <span class="insegna__motto">{sito.motto}</span>
      </span>
    </a>

    <nav class="navigazione" aria-label="Principale">
      <ul>
        {
          voci.map((voce) => (
            <li>
              <a href={voce.href} aria-current={attiva(voce.href) ? 'page' : undefined}>
                {voce.testo}
              </a>
            </li>
          ))
        }
      </ul>

      {
        sito.collegamenti.sostieni && (
          <a
            class="sostieni"
            href={sito.collegamenti.sostieni}
            rel="noopener"
            target="_blank"
            aria-label={`${sito.collegamenti.sostieniEtichetta || 'Offri qualcosa'} — sostieni Pico Edizioni (si apre in una nuova scheda)`}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              {/* vapore */}
              <path class="vapore" d="M9.4 2.6c-.7.8-.7 1.6 0 2.4s.7 1.6 0 2.4" />
              <path class="vapore" d="M13.4 2.6c-.7.8-.7 1.6 0 2.4s.7 1.6 0 2.4" />
              {/* tazza */}
              <path d="M4.2 10.2h13.2v3.4a5.1 5.1 0 0 1-5.1 5.1H9.3a5.1 5.1 0 0 1-5.1-5.1v-3.4Z" />
              {/* manico */}
              <path d="M17.6 11.4h1.1a2.3 2.3 0 0 1 0 4.6h-1.5" />
              {/* piattino */}
              <path d="M2.6 21h16.4" />
            </svg>
            <span>{sito.collegamenti.sostieniEtichetta || 'Offri qualcosa'}</span>
          </a>
        )
      }

      <InterruttoreTema />
    </nav>
  </div>
</header>

<style>
  .testata {
    border-bottom: 1px solid var(--filo);
    background: var(--carta);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .testata__interno {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
    flex-wrap: wrap;
    padding-block: 0.7rem;
  }

  .insegna {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--inchiostro);
  }

  .insegna:hover {
    color: var(--inchiostro);
  }

  .insegna:hover :global(.marca) {
    color: var(--bruno);
  }

  .insegna__testo {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    line-height: 1.1;
  }

  .insegna__nome {
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  .insegna__motto {
    font-size: 0.82rem;
    font-style: italic;
    color: var(--inchiostro-lieve);
  }

  .navigazione {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .navigazione ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .navigazione a {
    font-family: var(--sans);
    font-size: 0.775rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--inchiostro-tenue);
    padding-block: 0.35rem;
    border-bottom: 1px solid transparent;
  }

  .navigazione a:hover {
    color: var(--inchiostro);
  }

  .navigazione a[aria-current='page'] {
    color: var(--inchiostro);
    border-bottom-color: var(--zabaione-vivo);
  }

  /* Il collegamento per le donazioni non è una voce di menu: è un pulsante
     pieno, in zabaione, con inchiostro scuro sopra. Il colore è fisso nei due
     temi — è l'unico elemento del sito che deve saltare all'occhio. */
  /* La specificità deve superare quella di ".navigazione a", altrimenti il
     colore del testo del menu vince e il pulsante resta illeggibile. */
  .navigazione a.sostieni {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--sans);
    font-size: 0.7875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    color: #211c10;
    background: var(--zabaione);
    border: 1px solid var(--zabaione-vivo);
    padding: 0.62em 1.05em;
    line-height: 1;
    white-space: nowrap;
    margin-left: 0.6rem;
    transition: background-color 0.18s ease, transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .navigazione a.sostieni:hover {
    background: var(--zabaione-vivo);
    color: #211c10;
    transform: translateY(-1px);
    box-shadow: 0 2px 0 0 var(--bruno);
  }

  .sostieni:active {
    transform: translateY(0);
    box-shadow: none;
  }

  .sostieni svg {
    width: 1.2em;
    height: 1.2em;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Il vapore si alza appena al passaggio del mouse. */
  .sostieni .vapore {
    opacity: 0.75;
    transition: transform 0.35s ease, opacity 0.35s ease;
  }

  .sostieni:hover .vapore {
    opacity: 1;
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .sostieni,
    .sostieni .vapore {
      transition: none;
    }
    .sostieni:hover {
      transform: none;
    }
  }

  @media (max-width: 34rem) {
    .testata {
      position: static;
    }
    .testata__interno {
      justify-content: center;
      text-align: center;
    }
    .insegna__motto {
      display: none;
    }
    /* Sul telefono il menu va a capo sotto l'insegna, centrato, invece di
       uscire dallo schermo. */
    .navigazione {
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.6rem 0.9rem;
    }
    .navigazione ul {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.1rem;
    }
    /* La voce resta, ma più raccolta. */
    .sostieni {
      margin-left: 0;
      font-size: 0.7rem;
      padding: 0.45em 0.7em;
    }
  }
</style>
