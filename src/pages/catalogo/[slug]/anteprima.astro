---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { u, minutiLettura } from '../../../lib/percorsi';

// Esiste una pagina di anteprima solo per i libri che ne hanno una: il legame
// passa dal campo "libro" dell'anteprima, non dal nome del file.
export async function getStaticPaths() {
  const libri = await getCollection('libri');
  const anteprime = await getCollection('anteprime');

  return libri.flatMap((libro) => {
    const anteprima = anteprime.find((a) => a.data.libro === libro.slug);
    return anteprima ? [{ params: { slug: libro.slug }, props: { libro, anteprima } }] : [];
  });
}

interface Props {
  libro: CollectionEntry<'libri'>;
  anteprima: CollectionEntry<'anteprime'>;
}

const { libro, anteprima } = Astro.props;
const d = libro.data;

const { Content } = await anteprima.render();
const parole = anteprima.data.parole;
const percentuale = Math.round((parole / d.parole) * 100);
---

<Base
  titolo={`${d.titolo} — anteprima`}
  descrizione={`Le prime pagine di ${d.titolo} di ${d.autore}, nella traduzione italiana di Pico Edizioni.`}
  immagine={d.copertina}
  tipo="article"
>
  <div class="contenitore">
    <nav class="briciole non-stampare" aria-label="Percorso">
      <a href={u('/catalogo/')}>Catalogo</a>
      <span aria-hidden="true">→</span>
      <a href={u(`/catalogo/${libro.slug}/`)}>{d.titolo}</a>
      <span aria-hidden="true">→</span>
      <span aria-current="page">Anteprima</span>
    </nav>

    <article class="lettura">
      <header class="lettura__apertura">
        <p class="occhiello">{d.autore}</p>
        <h1>{d.titolo}</h1>
        <p class="lettura__dati tenue">
          Anteprima · {minutiLettura(parole)} minuti di lettura · circa il {percentuale}% del volume
        </p>
        <div class="filetto-ornato" aria-hidden="true"><span>◆</span></div>
      </header>

      <div class="prosa prosa--capolettera lettura__testo">
        <Content />
      </div>

      <footer class="lettura__chiusa non-stampare">
        <div class="filetto-ornato" aria-hidden="true"><span>◆</span></div>
        <p class="lettura__seguito">L'anteprima finisce qui.</p>
        <p class="tenue">
          Il volume intero è di {d.pagine} pagine e si scarica gratuitamente,
          senza registrazione.
        </p>
        <p class="lettura__azioni">
          <a class="bottone" href={u(d.epub)} download>Scarica l'ePub</a>
          <a class="bottone bottone--vuoto" href={u(`/catalogo/${libro.slug}/`)}>
            Torna alla scheda
          </a>
        </p>
      </footer>
    </article>
  </div>
</Base>

<style>
  .briciole {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--inchiostro-lieve);
    padding-block: 1.75rem 0;
  }

  .briciole a {
    text-decoration: none;
  }

  .briciole a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .lettura {
    max-width: 36rem;
    margin-inline: auto;
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(3rem, 8vw, 6rem);
  }

  .lettura__apertura {
    text-align: center;
  }

  .lettura__apertura .occhiello {
    display: block;
    margin-bottom: 0.8rem;
  }

  .lettura__apertura h1 {
    font-size: clamp(2rem, 1.5rem + 2.4vw, 3rem);
  }

  .lettura__dati {
    margin-top: 0.9rem;
    font-size: 0.85rem;
  }

  .lettura__apertura .filetto-ornato {
    margin-block: 2.5rem;
  }

  /* Nel corpo del testo i titoli di capitolo tornano centrati, come nel libro. */
  .lettura__testo :global(h2) {
    text-align: center;
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.45rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    margin-top: 3.2em;
    margin-bottom: 1.4em;
  }

  .lettura__testo :global(h2::after) {
    content: '';
    display: block;
    width: 2.5rem;
    height: 1px;
    background: var(--zabaione-vivo);
    margin: 0.9rem auto 0;
  }

  .lettura__testo :global(p) {
    text-align: justify;
    hyphens: auto;
  }

  .lettura__chiusa {
    text-align: center;
    margin-top: 3.5rem;
  }

  .lettura__chiusa .filetto-ornato {
    margin-bottom: 2.5rem;
  }

  .lettura__seguito {
    font-style: italic;
    font-size: 1.15rem;
  }

  .lettura__chiusa .tenue {
    margin-top: 0.6rem;
    font-size: 0.95rem;
  }

  .lettura__azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    justify-content: center;
    margin-top: 2rem;
  }

  @media (max-width: 34rem) {
    .lettura__testo :global(p) {
      text-align: left;
    }
  }
</style>
